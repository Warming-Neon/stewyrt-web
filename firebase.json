{
  "functions": {
    "source": "functions",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "flutter_service_worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "stewyrt-11",
          "appId": "1:9105005440:android:8b3e913cac5c391cbe7f65",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "stewyrt-11",
          "appId": "1:9105005440:ios:ae5dd89ec831d95fbe7f65",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "stewyrt-11",
          "configurations": {
            "android": "1:9105005440:android:8b3e913cac5c391cbe7f65",
            "ios": "1:9105005440:ios:ae5dd89ec831d95fbe7f65",
            "web": "1:9105005440:web:a2fa53b537e6600ebe7f65"
          }
        }
      }
    }
  }
}